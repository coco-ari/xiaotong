[Unit]
Description=Back up Xiaobu planner data
After=lifehub-planner.service

[Service]
Type=oneshot
User=nobody
Group=nogroup
WorkingDirectory=/opt/lifehub-planner
Environment=DATA_DIR=/opt/lifehub-planner/state
ExecStart=/usr/bin/node /opt/lifehub-planner/server/backup.mjs
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/lifehub-planner/state
