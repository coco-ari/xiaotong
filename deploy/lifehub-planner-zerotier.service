[Unit]
Description=Forward Xiaobu ZeroTier gateway to local app
Requires=lifehub-planner.service
After=lifehub-planner.service

[Service]
Type=notify
User=nobody
Group=nogroup
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18787
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
IPAddressDeny=any
IPAddressAllow=localhost
